---
import Layout from "../layouts/Layout.astro";
import '../styles/globals.css';

import { getCollection } from "astro:content";

const artiklar = await getCollection('artiklar');
---

<Layout>
    <div class='card card-grey text-justify'>
        {artiklar.map(artikkel => (
            <p class='text-body'>
                <a href = {artikkel.data.slug} class='textLink'> {artikkel.data.slug} </a>
            </p>
        ))}
    </div>
</Layout>