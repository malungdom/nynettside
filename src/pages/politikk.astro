---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/button.astro'
import FraasegnModal from '../components/politikk/fraasegner.astro';
import FraasegnReact from '@components/politikk/fraasegnerReact';

import { getCollection } from 'astro:content';

const fraasegner = await getCollection('fraasegner');
const fraasegnerMetadata = await Promise.all(
	fraasegner.map((fraasegn) => {
		return {
			title: fraasegn.data.title,
			date: fraasegn.data.date,
		}
	})
)


const politiskProgram = [
	{
		title: 'Arbeids\u00ADprogram',
		path: '/politikk/program/arbeidsprogram/2025-2026',
		image: '/politikk/kalender.png'
	},
	{
		title: 'Inter\u00ADnasjonalt Program',
		path: '/politikk/program/internasjonalt-program',
		image: '/politikk/mangeflag.png'
	},
	{
		title: 'Noreg som fleir\u00ADspråkleg samfunn',
		path: '/politikk/program/noreg-som-fleirsprakleg-samfunn',
		image: '/politikk/samisk.png'
	},
	{
		title: 'Nynorsk i lærar\u00ADutdanning',
		path: '/politikk/program/nynorsk-i-laerarutdanningane',
		image: '/politikk/kalender.png'

	},
	{
		title: 'Språk i akademia og høgare utdanning',
		path: '/politikk/program/sprak-i-akademia-og-hogare-utdanning',
		image: '/politikk/kalender.png'

	},
	{
		title: 'Språk i skulen',
		path: '/politikk/program/sprak-i-skulen',
		image: '/politikk/kalender.png'

	},
	{
		title: 'Språk i ein digital kvardag',
		path: '/politikk/program/sprak-i-ein-digital-kvardag',
		image: '/politikk/kalender.png'

	},
	{
		title: 'Talemålet og nynorsken',
		path: '/politikk/program/talemalet-og-nynorsken',
		image: '/politikk/kalender.png'

	},
]
---

<Layout currentPage='/politikk'>
	<!--Hero-seksjon -->
	<div>
	<section class='grid grid-cols-1 md:grid-cols-[3fr_3fr] bg-[var(--light-blue)] bg-white shadow-0xl'>
		<div class='flex flex-col gap-10 justify-around pl-[var(--bleed)] md:pr-20 py-15 my-0'>
			<h1 class='text-center md:text-[3cqi]'>Den politiske verksemda vår</h1>
			<p class='text-subhead text-left italic'>Norsk Målungdom verjar og fremjar interessene til nynorsk og dialektane og samarbeider aktivt med Noregs Mållag for å få politiske gjennomslag for nynorsk.
			</p>
			<p class='text-subhead italic'>
			NMU utformar sin eigen politikk og arbeidsprogram og skriv fråsegner om aktuelle tema som du kan lesa her.
			</p>
		</div>
		<div>
			<img src='/marentalar.jpg' class='w-[100svw] overflow-visible' />
		</div>
	</section>
	<!--Vanleg seksjon-->
	<!--section class='flex flex-col text-center gap-[var(--hl-con-gap)] margined'-->
	<div class='bg-[var(--light-blue)] py-40'>
	<section class='margined section-3-2 relative items-start'>
		<!--Element for arbeidsprogram-->
		<!--nav class='card bg-[var(--light-grey)] p-5 grid grid-cols-1 gap-5 md:gap-1 mx-5 md:absolute md:inset-0 md:col-start-2 overflow-scroll'-->
		<nav class='grid grid-cols-1 gap-2 p-0 bg-[var(--light-grey)] bg-white'>
				{politiskProgram.map((program, i) => ( 
					<a href={program.path} class='w-full ease-in-out isolate'>
						<div class=`card ${i % 2 == 0 ? 'bg-[var(--main-green)]' : 'bg-[var(--main-green)]'} py-5 `>
							<p class='px-5 text-left text-body text-[var(--main-blue)] text-white font-bold sunderline'>{program.title}</p>
						</div>
					</a>
				))}
		</nav>
		<div class='sticky-center grid gap-[var(--hl-con-gap)]'>
			<h1 class='text-headline'>Politiske program</h1>
			<p class='italic text-subhead'>NMU vedtar ulike politiske program som legg grunnlag for organisajonen. Dei politiske programma er tankegrunnlaget til dei politiske standpunkta våre.</p>
		</div>
	</section></div></div>
	<!--Fråsegner-->
	<section class=''>
	<div class='margined section-1-2 relative '>
		<div class='hero-text px-0 py-0'>
			<h1 class='text-headline'>Fråsegner</h1>
			<p class='italic text-body'>NMU vedtar fråsegner om aktuelle tema</p>
		</div>
		<nav class='grid grid-cols-1 bg-[var(--light-blue)] p-10 gap-5 md:gap-1 my-5 h-[50vh] overflow-y-auto'>
				{fraasegnerMetadata.map((stmt, i) => (
					<div id={`stmt-${i}`} class='card card-green py-10'>
						<p class='text-center text-body text-black'>{stmt.title}</p>
					</div>
				))}
		</nav>
	</div>
	</section>
	<FraasegnReact fraasegner={fraasegner} client:load />
</Layout>
