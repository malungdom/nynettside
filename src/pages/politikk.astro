---
import Layout from '../layouts/Layout.astro';
import Button from '../components/ui/button.astro'
import Card from '../components/ui/card.astro';
import FraasegnModal from '../components/politikk/fraasegner.astro';
import FraasegnReact from '@components/politikk/fraasegnerReact';

import { getCollection } from 'astro:content';

const fraasegner = await getCollection('fraasegner');
const fraasegnerMetadata = await Promise.all(
	fraasegner.map((fraasegn) => {
		return {
			title: fraasegn.data.title,
			date: fraasegn.data.date,
		}
	})
)


const politiskProgram = [
	{
		title: 'Arbeids\u00ADprogram',
		path: '/politikk/program/arbeidsprogram/2025-2026',
		image: '/politikk/kalender.png'
	},
	{
		title: 'Inter\u00ADnasjonalt Program',
		path: '/politikk/program/internasjonalt-program',
		image: '/politikk/mangeflag.png'
	},
	{
		title: 'Program for Noreg som fleir\u00ADspråkleg samfunn',
		path: '/politikk/program/noreg-som-fleirsprakleg-samfunn',
		image: '/politikk/samisk.png'
	},
	{
		title: 'Nynorsk i lærar\u00ADutdanning',
		path: '/politikk/program/nynorsk-i-laerarutdanningane',
		image: '/politikk/kalender.png'

	},
	{
		title: 'Språk i akademia og høgare utdanning',
		path: '/politikk/program/sprak-i-akademia-og-høgare-utdanning',
		image: '/politikk/kalender.png'

	},
	{
		title: 'Språk i skulen',
		path: '/politikk/program/sprak-i-skulen',
		image: '/politikk/kalender.png'

	},
	{
		title: 'Språk i ein digital kvardag',
		path: '/politikk/program/sprak-i-ein-digital-kvardag',
		image: '/politikk/kalender.png'

	},
	{
		title: 'Talemålet og nynorsken',
		path: '/politikk/program/talemalet-og-nynorsken',
		image: '/politikk/kalender.png'

	},
]
---

<Layout currentPage='/politikk'>
	<!--Hero-seksjon -->
	<section class='grid grid-cols-1 md:grid-cols-2 bg-[var(--light-blue)] shadow-xl'>
		<div class='hero-text'>
			<h1 class='text-center text-[4cqi]'>Den politiske verksemda vår</h1>
			<p class='text-justify'>Norsk Målungdom verjar og fremjar interessene til nynorsk og dialektane og samarbeider aktivt med Noregs Mållag for å få politiske gjennomslag for nynorsk.
				<br/><br/>NMU utformar sin eigen politikk og arbeidsprogram og skriv fråsegner om aktuelle tema som du kan lesa her.</p>
		</div>
		<img src='/marentalar.jpg' class='w-full h-full object-cover' />
	</section>
	<!--Vanleg seksjon-->
	<!--section class='flex flex-col text-center gap-[var(--hl-con-gap)] margined'-->
	<section class='margined section-1-2 relative'>
		<!--Element for arbeidsprogram-->
		<div class='hero-text px-0 py-0'>
			<h1 class='text-headline'>Politiske program</h1>
			<p class='italic text-body'>NMU vedtar ulike politiske program som legg grunnlag for organisajonen. Dei politiske programma er tankegrunnlaget til dei politiske standpunkta våre.</p>
		</div>
		<nav class='grid grid-cols-1 gap-5 md:gap-1 mx-5 md:absolute md:inset-0 md:col-start-2 overflow-scroll'>
				{politiskProgram.map((program) => ( 
					<a href={program.path} class='w-full ease-in-out isolate'>
						<Card colorSet='var(--light-blue)' class='py-10'>
							<p class='text-center text-body text-black'>{program.title}</p>
						</Card>
					</a>
				))}
		</nav>
	</section>
	<!--Fråsegner-->
	<section class='bg-[var(--light-blue)]'>
	<div class='margined section-2-1 relative '>
		<nav class='grid grid-cols-1 gap-5 md:gap-1 my-5 h-[50vh] overflow-y-auto'>
				{fraasegnerMetadata.map((stmt, i) => (
					<Card id={`stmt-${i}`} colorSet='var(--light-grey)' class='py-10'>
						<p class='text-center text-body text-black'>{stmt.title}</p>
					</Card>
				))}
		</nav>
		<div class='hero-text px-0 py-0'>
			<h1 class='text-headline'>Fråsegner</h1>
			<p class='italic text-body'>NMU vedtar fråsegner om aktuelle tema</p>
		</div>
	</divk
	k/section>
	<FraasegnReact fraasegner={fraasegner} client:load />
</Layout>
