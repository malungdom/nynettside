---
import Layout from "@layouts/Layout.astro";

import '@styles/globals.css';

import { getCollection } from "astro:content";
import { render } from "astro:content";

const songar = await getCollection('songar')

const songData = await Promise.all(
    songar.map(async (song) => {
        return {
            title: song.data.title,
            author: song.data.author,
            tone: song.data.tone,
            Content: (await render(song)).Content
        }
    })
)
---

<Layout class='bg-[var(--light-blue)]'>
    <h1 class='page-title text-headline text-center px-5 pt-[var(--hl-con-gap)]'>Songheftet til Norsk Målungdom</h1>
    <section class='overflow-x-clip'>
        <a href='#song-anchor' class='button jump-mobile flex items-center justify-center sticky top-[100svh] -translate-y-2/3 z-100 md:hidden bg-[var(--main-green)]'>
            <p class='text-white text-subhead'>Gå til songteksten</p>
        </a>
        <div class='margined grid text-center items-center gap-[var(--hl-con-gap)]'>
            <div class='card card-grey grid grid-cols-2 md:grid-cols-5 rounded-2xl p-3 md:p-10'>
                <div class='col-span-2 md:col-span-5 grid grid-cols-1 md:grid-cols-5'>
                    <h1 class='catalog-title text-center text-headline md:col-start-2 md:col-span-3 py-6 md:py-10'>Songkatalogen vår</h1>
                    <button id='lucky-button' class='button md:col-start-2 md:col-span-3 bg-[var(--main-green)]'>
                        <p class='text-white text-subhead'>Prøv lukka!</p>
                    </button>
                    <a href='#song-anchor' class='button flex items-center justify-center max-md:hidden md:col-start-2 md:col-span-3 bg-[var(--main-green)]'>
                        <p class='text-white text-subhead'>Gå til songteksten</p>
                    </a>
                </div>
                <div class='hidden md:block md:col-span-5 md:h-[75px]' >
                </div>
                {songar.map((song, i) => ( 
                    <button id={`knapp-${i}`} class='button song-button bg-[var(--light-blue)] hover:bg-[var(--halflight-blue)] transition-colors duration-600 z-50'>
                        <p class='text-body'>
                            {song.data.title}
                        </p>
                    </button>
                ))}
            </div>
		<div id='song-anchor' class='max-md:pt-[15svh]'></div>
        </div>
    </section>
    <section id='song-section' class='bg-[var(--light-blue)] bg-white py-[var(--hl-con-gap)]'>
        <div class='margined text-center'>
            {songData.map((song, i) => (
                <div id={`song-${i}`} class='hidden'>
                    <div class='grid items-center align-center justify-center mx-auto'>
                        <h1 class='song-title pb-[var(--hl-con-gap)]'>{song.title}</h1>
                        <h2 class=''>Song: {song.author}</h2>
                        {song.tone && <h2 class=''>Tone: {song.tone}</h2>}
                    </div>
                    <div class='grid items-center align-center justify-center mx-auto pt-[var(--hl-con-gap)]'>
                        <div class='content w-fit max-w-full text-subhead'>
                            <song.Content/>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </section>
</Layout>

<style>
    .selected {
        
    }

    .content {
        display: flex;
        flex-direction: column;
        gap: 3rem;
        text-align: left;
        margin-bottom: 50px;
    }
    .content p {
        display: inline-block;
        font-size: var(--font-body);
    }

    .button {
        min-width: 0;
        margin: 5px;
        height: 75px;
        padding: 0 0.75rem;
        border: 0px solid black;
        border-radius: 10px;
        overflow-wrap: anywhere;
        rotate: 0deg;
        scale: 1;
        transition: rotate 0s, scale 0.5s ease;
    }


    @media (max-width: 767px) {
        .button {
            height: auto;
            min-height: 56px;
            padding: 0.6rem 0.75rem;
            margin: 4px;
        }
        .song-button p {
            font-size: 0.9rem;
            line-height: 1.25;
        }
        .page-title {
            font-size: 2.25rem;
            line-height: 1.15;
        }
        .catalog-title {
            font-size: 2rem;
            line-height: 1.15;
        }
        .song-title {
            font-size: 2rem;
            line-height: 1.15;
            overflow-wrap: anywhere;
        }
        .content {
            gap: 1.5rem;
            margin-bottom: 30px;
        }
        .content :global(p) {
            font-size: 1rem;
        }
        /* Sticky shortcut: full width minus the page gutter */
        .button.jump-mobile {
            /* negative bottom margin so the sticky button takes no space in the flow */
            margin: 0 1.25rem -56px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
        }
    }


    .selected {
        background-color: var(--main-blue);
        color: white;
    }

    .animated {
        rotate: 360deg;
        scale: 1.3;
        transition: rotate 1s, scale 0.5s ease;
    }
</style>

<script define:vars={{ songData }}>
    let test = false;
    let currentSong = document.getElementById(`song-0`)
    let currentButton = document.getElementById(`knapp-0`)
    const len = songData.length;
    let currentI = 0;

    for (const [i, song] of songData.entries()) {
        const knappEl = document.getElementById(`knapp-${i}`)

        knappEl?.addEventListener('click', () => {
	    if (i != currentI) {    
	    	switchSong(i);
	    }
	
	});
    }

    const luckyButton = document.getElementById('lucky-button');
    luckyButton?.addEventListener('click', async () => {
        const min = 30;
        const max = 50;
        const shift = Math.floor(Math.random() * (max - min) + min);

        const totalTime = 5;
        let times = [];
        let sum = 0;
        for (i = shift; i > 0; i--) {
            const t = 1 - Math.pow((shift - i), 3);
            times.push(t);
            sum += t;
        }
        const factor = sum / totalTime;

        for (i = 0; i < shift; i++) {
            switchSong((currentI + 1) % len);
            await sleep(times[i] / factor * 1000);
        }

        const knappEl = document.getElementById(`knapp-${currentI}`)

        knappEl?.classList.add('animated');
        knappEl?.classList.add('z-100');
        await sleep(1000);
        knappEl?.classList.remove('animated');
        await sleep(1000);
        knappEl?.classList.remove('z-100');
        knappEl?.classList.add('z-50');

    })

    function switchSong(i) {
        const knappEl = document.getElementById(`knapp-${i}`)
        const songEl = document.getElementById(`song-${i}`)

        songEl?.classList.remove('hidden');
        currentSong?.classList.add('hidden');
        currentSong = songEl;

        currentButton?.classList.remove('selected');
        knappEl?.classList.add('selected');

        currentButton = knappEl;
        currentI = i;
    }

    function sleep(ms) {
        return new Promise(resolve => setTimeout(resolve, ms));
    }
</script>
