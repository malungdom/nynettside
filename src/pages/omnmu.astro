---
import Layout from '../layouts/Layout.astro';
import Card from '../components/ui/card.astro';
import Pinpoint from '@assets/images/pinpoint_blue.png';
import LocationIcon from '@assets/images/pinpoint.png';
import RegnbogeLogo from '@assets/images/regnboge-logo.png';

import '@styles/globals.css';
import { getCollection } from 'astro:content';

const lokallag = await getCollection('lokallag');


const leftB = 4.6490235;
const rightB = 30.9380483;
const topB = 71.185367;
const bottB = 57.9831902;

function coordToFrac(lat: number, lon: number) {
	const merY = latitude => Math.log(Math.tan(Math.PI / 4 + latitude * Math.PI / 360));

	return [100 * (merY(lat) - merY(bottB)) / (merY(topB) - merY(bottB)),
			100 * (lon - leftB) / (rightB - leftB)]
}

const coords = lokallag.map( (lokallag) => {
	return {
		id: lokallag.id,
		coord: coordToFrac(lokallag.data.latitude, lokallag.data.longitude) 
	}
});

// Organizing them into colocated groups

const threshold = 0.25;
let groups: Array<Array<Object>> = [];

const distanceCalc = coordPair => Math.hypot((coordPair[0][0] - coordPair[1][0]), (coordPair[0][1] - coordPair[1][1]));

for (const chapter of coords) {
	let foundPreviousChapter = false;
	for (const group of groups) {
		if (distanceCalc([chapter.coord, group[0].coord]) < threshold) {
			group.push(chapter);
			foundPreviousChapter = true;
		}
	}
	if (foundPreviousChapter == false) {
		groups.push([chapter])
	}
}


---
<Layout currentPage='/omnmu'>
	<section class='margined flex flex-col gap-[var(--global-gap)]'>
		<div class='grid pt-[var(--hl-con-gap)] items-center text-center gap-[var(--hl-con-gap)] w-full max-w-[30rem]'>
			<h1 class='text-headline'>Finn ditt lokallag!</h1>
			<div class='relative'>
				<div class='absolute inset-0'>
					{groups.map((group, i) => (
						<div class='absolute' id={`pinpoint-${i}`} style={{
							bottom: `${group[0].coord[0]}%`,
							left: `${group[0].coord[1]}%`,
							transform: 'translate(-50%, 0%)'
						}}>
							<p class='absolute bg-[var(--main-green)] text-white rounded-small text-body px-1 -translate-y-1/1'>{group.length != 1 && group.length}</p>
							<img src={Pinpoint.src}>
						</div>
					))}
				</div>
				<img src='/omnmu/noregskartmercator.svg' class='w-full' />
			</div>
		</div>
		<div class='flex flex-col gap-[1rem]'>
			{lokallag.map((lokallag) => ( 
				<div id={`card-${lokallag.id}`} class='hidden'>
 					<Card colorSet='var(--light-grey)' borderwidth='0px' class='rounded-standard shadow-2xl grid md:grid-cols-2 overflow-clip'>
 					    <div class='min-h-0 px-5 py-8 md:px-10 grid grid-cols-[auto_1fr] gap-2'>
 					        <h1 class='text-left text-subhead font-bold col-span-2'>{lokallag.data.name}</h1>
 					        <img class='-translate-y-1 md:translate-y-0 h-[1.5rem]' src={LocationIcon.src} /> 
							<p class='text-body'>{lokallag.data.place}</p>
 					    </div>
						<div class='min-h-0 flex relative '>
 					    	<img src={lokallag.data.image ? lokallag.data.image : RegnbogeLogo.src} class='absolute object-contain h-full right-0'>
						</div>
 					</Card>
				</div>
			))}
		</div>
		<p id='teamtext' class='text-body'>Test</p>
	</section>
</Layout>

<script define:vars={{lokallag, groups}}>
	const byId = new Map(lokallag.map((lag) => [lag.id, lag.data.name]))

	const textField = document.getElementById('teamtext');

	for (const [i, group] of groups.entries()) {
		document.getElementById(`pinpoint-${i}`).addEventListener('click', () => {
			for (lag of lokallag) {
				const el = document.getElementById(`card-${lag.id}`);
				el?.classList.add('hidden');
			}

			for (coord of group) {
				const name = byId.get(coord.id);
				const lag = document.getElementById(`card-${coord.id}`);
				lag?.classList.toggle('hidden');
			}
		})
	}
</script>