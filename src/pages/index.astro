---
import Layout from '@layouts/Layout.astro';
import Button from '@components/ui/button.astro';
import Hero from '@components/index/hero.astro';
import Card from '@components/ui/card.astro';
import Hendingar from '@components/index/hendingar.astro';
import '@styles/globals.css';

const goalCards = [
    {
        head: 'Likeverd mellom nynorsk og bokmål',
        image: 'aasen.png',
        link: ''
    },
    {
        head: 'Betre sidemål i skulen',
        image: 'grammatikk.png',
        link: ''
    },
    {
        head: 'Lover som respekterer språkleg mangfald',
        image: 'fireflag.png',
        link: ''
    },
]
---

<Layout currentPage='/' class='text-center'>
    <Hero id='hero-section'/>
        <h1 class='text-headline col-span-full'>Kva kjempar me for?</h1>
    <section id='goal-cards' class='margined grid gap-[var(--hl-con-gap)]'>
        <div class='h-fit grid grid-cols-1 md:grid-cols-3 gap-10'>
            {goalCards.map( ({ head, image, link }) => (
                <Card colorSet='var(--main-blue)' class='h-full grid grid-rows-[1fr_auto_auto] gap-10 md:gap-20 py-10 px-10 rounded-standard'>
                    <h1 class='text-white text-headline text-center leading-15'>{head}</h1>
                    <img src={image} class='h-4/5 mx-auto items-center'>
                    <a href={link} class='flex flex-row m-auto gap-2 text-center text-subhead text-white font-bold'>
                            <p class='hover:translate-x-2 transition duration-300'>Les meir ></p>
                    </a>
                </Card>
            ))}
        </div>
    </section>
    <section id='hending-section' class='bg-[var(--light-blue)] py-[var(--hl-con-gap)]'>
        <div class='margined section-1-2 items-start'>
            <div class='sticky-center'>
                <h1 class='text-center h-full mx-auto md:text-left text-headline text-black'>Kvissleis skjer fram&shy;over?</h1>
            </div>
            <Hendingar />
        </div>
    </section>
    <!-- section class='margined gap-[var(--hl-con-gap)] grid grid-cols-1 md:grid-cols-2' -->
    <section class='margined section-3-2'>
            <p class='text-subhead font-light italic leading-16 text-left'>
			    «Det språklege mangfaldet i verda er umisteleg, av di kvart språk har sin unike måte å tolka røynda på. Norske dialektar, skriftspråk og mindretalsspråk er Noregs bidrag til det globale språkmangfaldet. Det er vår oppgåve å tryggja og byggja vidare på dette bidraget.»
			</p>
            <h1 class='text-headline text-left'>
                Tufta til Norsk Målungdom
            </h1>
    </section>
</Layout>

<script>
    const smallButton = document.getElementById('hero-CTAbutton');
    const cta = document.getElementById('banner-button');

    const observer = new IntersectionObserver(
        ([entry]) => {
            cta?.classList.toggle('cta-hidden', entry.isIntersecting);
        },
        { threshold: 0.1}
    )

    if (smallButton) observer.observe(smallButton);
</script>

