
---
import Button from '@components/ui/button.astro';

const { class: className } = Astro.props;
---

<div class={`${className} m-0`} >
    <div class={`w-full md:mb-10 md:mx-auto md:p-8 p-5 flex flex-col gap-5 margined md:rounded-standard md:card card-blue bg-[var(--main-blue)]`}>
        <p class='text-black text-white md:text-white text-subhead text-left md:text-justify pb-5'>
    		Norsk Målungdom er eit lands&shy;dekkjande mållag med over 1200 elevar og studentar som kjempar for nynorsk, dialekt og språk&shy;mangfald i Noreg. 
        </p>
        <Button id='hero-CTAbutton' colorSet='lav' path='/omnmu' classes='w-full'>
            <p>Meld deg inn!</p>
        </Button>
    </div>
</div>
