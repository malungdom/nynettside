---
const { borderColor = 'main-green', borderwidth  = '0px', colorSet = 'grey', class: className = "" } = Astro.props;
import '../../styles/globals.css';
---

<div class={`textCard ${className}`} style={`--bg-color: ${colorSet}; --border-width: ${borderwidth}`}>
    <slot />
</div>

<style>
  .textCard {
    background-color: var(--main-lgrey);
    background-color: var(--main-lav);
    background-color: var(--light-color);
    background-color: var(--main-color);
    background-color: var(--bg-color);
    border: 2px solid black;
    border: var(--border-width) solid var(--main-green);
    text-align: justify;
    box-shadow: 4px 4px 0px rgba(0,0,0,1);
    box-shadow: 4px 4px 0px rgba(17,41,8,0.8);
    box-shadow: 0 5px 10px rgba(0,0,0,0.4);
    transform: translate(0px, 0px);
    transition: all 0.6s ease-in-out;
  }
  .textCard:hover {
    box-shadow: 10px 10px 0px rgba(0,0,0,1);
    box-shadow: 10px 10px 0px rgba(17,41,8,1);
    box-shadow: 0 10px 33px rgba(0, 0, 0, 0.90);
    transition: all 0.3s ease-in-out;
  }
</style>