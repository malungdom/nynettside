---
import '../styles/globals.css'

const { currentPage, class: className } = Astro.props;
import Banner from '@components/layout/banner.astro';
import Footer from '@components/layout/footer.astro';
---

<!doctype html>
<html lang="no">
	<head>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
    	<style>
        	body {
        		visibility: hidden;
        	}
    	</style>
    	<script>
        	document.fonts.ready.then(() => {
            	document.body.style.visibility = 'visible';

				document.querySelectorAll('.slide-up').forEach(el => {
            		(el as HTMLElement).style.animationPlayState = 'running'
        		})
			})
    	</script>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>(dev) Norsk Målungdom</title>
	</head>
	<body>
		<div id='site-banner' class='fixed w-full z-200'>
			<Banner pagePath={currentPage} />
		</div>
		<div class='bannerH'/>
		<div id='master-div' class={`w-full min-h-screen flex flex-col gap-[var(--global-gap)] ${className}`}>
			<slot />
		</div>
		<Footer/>
		<script>
			// Centre every .sticky-center block in the space below the fixed banner.
			// Its own height can't be used in CSS, so measure it and set --sticky-top.
			const stickies = document.querySelectorAll<HTMLElement>('.sticky-center');
			if (stickies.length) {
				const banner = document.getElementById('site-banner');
				const margin = 16;
				const place = () => {
					const bannerBottom = banner ? Math.max(0, banner.getBoundingClientRect().bottom) : 0;
					const space = window.innerHeight - bannerBottom;
					stickies.forEach((el) => {
						const centred = bannerBottom + (space - el.offsetHeight) / 2;
						// Taller than the space: pin just under the banner instead
						el.style.setProperty('--sticky-top', `${Math.round(Math.max(bannerBottom + margin, centred))}px`);
					});
				};
				place();
				window.addEventListener('resize', place);
				const observer = new ResizeObserver(place);
				stickies.forEach((el) => observer.observe(el));
				if (banner) observer.observe(banner);
				document.fonts.ready.then(place);
			}
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	
	}
	
	.bannerH {
		height: var(--banner-h-desktop);
	}

	@media(max-width: 768px) {
		.bannerH {
			height: var(--banner-h-mobile);
		}
	}
</style>
